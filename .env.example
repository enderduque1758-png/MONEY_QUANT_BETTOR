# Vercel server-side environment variables
# Configure these in Project Settings > Environment Variables.
THE_ODDS_API_KEY=
API_FOOTBALL_KEY=

# Optional but recommended: durable server persistence via Upstash Redis / Vercel KV-compatible REST.
# If omitted, the app falls back to ephemeral server memory plus localStorage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative compatible names also supported:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional future integrations
# BETANO_API_KEY=
